{
  "name": "relaydesk-global-support-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hostable multilingual AI support workspace MVP for micro and small sellers",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:llm": "node scripts/start-with-dsh-llm.mjs",
    "repair:worker": "node scripts/repair-worker.mjs",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:ui": "playwright test --workers=1",
    "test:ui:phase13": "playwright test e2e/PHASE13-UI-MATRIX.spec.ts --workers=1",
    "test:ui:cloud": "node scripts/run-cloud-smoke.mjs",
    "test:visual": "node scripts/run-visual.mjs",
    "test:visual:update": "node scripts/run-visual.mjs --update",
    "qa:inventory": "node scripts/ui-inventory.mjs",
    "qa:links": "node scripts/dead-links.mjs",
    "qa:locales": "node scripts/locale-coverage.mjs",
    "qa:geometry": "node scripts/ui-geometry-warnings.mjs",
    "test:gpc": "node --test test/gpc.test.js",
    "test:kb": "node --test test/kb-seed.test.js",
    "check": "node --check server.js && node --check public/app.js && node --test",
    "inject:knowledge": "node scripts/inject-p2-knowledge.mjs",
    "migrate:sqlite": "node scripts/migrate-json-to-sqlite.mjs",
    "ingest:gpc": "node scripts/ingest-gpc.mjs",
    "seed:kb": "node scripts/seed-kb.mjs",
    "verify:sqlite": "node scripts/verify-sqlite.mjs",
    "prune:data": "node scripts/prune-data.mjs",
    "backup:sqlite": "node scripts/backup-sqlite.mjs",
    "batch:overnight": "node scripts/run-full-batch.mjs --all --workers 3",
    "batch:cloud": "node scripts/run-cloud-batch.mjs --workers 18",
    "model:switch": "node scripts/switch-model.mjs",
    "index:harrier": "node scripts/build-harrier-index.mjs",
    "eval:harrier": "node scripts/eval-harrier-recall.mjs",
    "requeue:cards": "node scripts/requeue-problem-cards.mjs"
  },
  "engines": {
    "node": ">=25.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0"
  }
}
