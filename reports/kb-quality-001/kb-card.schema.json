{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relaydesk.local/schemas/kb-card.schema.json",
  "title": "KB Knowledge Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "card_id", "version", "knowledge_type", "audience", "industry", "locale",
    "intent_id", "aliases", "required_slots", "answer", "steps", "preconditions",
    "exceptions", "evidence", "source_id", "source_url", "source_span",
    "source_hash", "license_status", "review_status"
  ],
  "properties": {
    "card_id": { "type": "string", "pattern": "^kb_[a-z0-9_]+$" },
    "version": { "type": "integer", "minimum": 1 },
    "knowledge_type": {
      "type": "string",
      "enum": ["how_to", "policy", "troubleshooting", "feature_explainer", "intent_pattern", "known_issue", "faq"]
    },
    "audience": {
      "type": "string",
      "enum": ["seller", "buyer", "platform_support", "internal_eval"]
    },
    "industry": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$" },
    "intent_id": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
    "aliases": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "required_slots": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z_]+$" },
      "maxItems": 8
    },
    "answer": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "steps": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 12 },
    "preconditions": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "exceptions": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "quote"],
        "properties": {
          "source_id": { "type": "string" },
          "quote": { "type": "string", "minLength": 8 }
        }
      }
    },
    "source_id": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "license_status": { "type": "string", "enum": ["approved_with_attribution", "review_required", "blocked"] },
    "review_status": { "type": "string", "enum": ["approved", "needs_review", "rejected"] },
    "numbers_preserved": { "type": "boolean" },
    "notes": { "type": "string" }
  }
}
