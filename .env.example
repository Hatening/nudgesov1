PORT=3030
HOST=127.0.0.1
DATA_DIR=.data
# SQLite database (WAL mode). Defaults to DATA_DIR/relaydesk.sqlite.
DB_PATH=.data/relaydesk.sqlite
# Optional local Ollama endpoint. Leave empty to use safe extractive fallback.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=25000
# Optional OpenAI-compatible provider (disabled unless key + provider are set).
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Header/scheme for providers that do not use Authorization: Bearer.
# DSH account token: LLM_AUTH_HEADER=x-dsh-auth-token, LLM_AUTH_SCHEME=
LLM_AUTH_HEADER=authorization
LLM_AUTH_SCHEME=Bearer
LLM_RESPONSE_FORMAT=json_object
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_MS=45000
# External monitor -> local repair queue. Fail closed when the secret is empty.
REPAIR_WEBHOOK_SECRET=
REPAIR_QUEUE_DIR=./artifacts/repair-queue
REPAIR_WORKER_ENABLED=1
# Optional command that receives the generated repair prompt file.
# DSH_REPAIR_COMMAND=
# Data retention for messages/escalations (days).
PRIVACY_RETENTION_DAYS=365
# Set a long random value before exposing the service publicly; MVP does not include full user auth.
APP_API_KEY=
# Required in production for stable cookie/CSRF signatures.
SESSION_SECRET=
# Set to 1 when TLS is terminated by a trusted reverse proxy.
COOKIE_SECURE=0
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=
TRUST_PROXY=0
# Fixed-window API limits (requests per window).
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PUBLIC_MAX=600
RATE_LIMIT_ASR_MAX=60
RATE_LIMIT_V1_MAX=1200
RATE_LIMIT_LEGACY_MAX=600
